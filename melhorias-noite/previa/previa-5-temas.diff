+  .sug-op,.mun-op{min-height:48px}
+  .mt-regcards button{min-height:44px;align-content:center}   /* com a legenda recolhida (.sem-nae) os cartões das regionais caem para 27 px */
+  /* orelhinha da legenda (parte da outra sessão): com a legenda aberta o clique vale para o painel inteiro (leg.addEventListener('click')),
+     então não há o que mudar; recolhida, sobra só a orelhinha (30 px): o visual não muda, a área de toque ganha 8 px (da borda interna) para cada lado */
+  .mt-regs.fechada .mt-regs-b{position:relative;left:auto;top:auto}   /* (a regra de base tem left:50%; sem zerar, a orelha recolhida andaria 50 %) */
+  .mt-regs.fechada .mt-regs-b::after{content:"";position:absolute;inset:-8px}
+}
+
+/* ====== Zoom livre do mapa : acrescentar ao fim de assets/site.css ====== */
+/* um dedo continua rolando a página; a pinça de dois dedos é tratada em mapa-municipios.js (touchmove não passivo) */
+.mt-mapa{touch-action:pan-x pan-y}
+/* aproximado: o mapa usa a largura toda da caixa, recorta o que passa e um dedo arrasta o mapa */
+.mt-mapa.zoomando>svg{touch-action:none;overflow:hidden;cursor:grab;border-radius:var(--r3);outline:1px solid var(--line);outline-offset:-1px}
+.mt-mapa.arrastando{user-select:none}
+.mt-mapa.arrastando>svg,.mt-mapa.arrastando .mun{cursor:grabbing!important}
+/* botões + ⤢ − (e o fator ×N) */
+.mt-zoom{position:absolute;right:0;top:calc(var(--alvo) + var(--s2));z-index:4;display:grid;grid-auto-rows:var(--alvo);justify-items:stretch;
+  border:1px solid var(--line);border-radius:var(--r2);background:var(--paper);box-shadow:var(--sh1);overflow:hidden}
+.mt-zoom button{display:grid;place-items:center;width:var(--alvo);padding:0;border:0;border-radius:0;background:none;color:var(--fg);cursor:pointer}
+.mt-zoom button+button,.mt-zoom output+button,.mt-zoom button+output{border-top:1px solid var(--line)}
+.mt-zoom button:hover:not(:disabled){background:var(--hover);color:var(--accent)}
+.mt-zoom button:disabled{color:var(--muted);opacity:.45;cursor:default}
+.mt-zoom button:focus-visible{outline-offset:-2px}
+.mt-mapa .mt-zoom svg{width:20px;height:20px;min-height:0;max-height:none;margin:0;fill:none;stroke:currentColor;stroke-width:2;stroke-linecap:round;stroke-linejoin:round}
+.mt-zn{display:grid;place-items:center;font:700 var(--t-xs) var(--f-mono);font-variant-numeric:tabular-nums;color:var(--muted)}
+.mt-zn[hidden]{display:none}
+/* dica "Use Ctrl + rolagem": aparece só quando se rola por cima do mapa sem Ctrl */
+.mt-zdica{position:absolute;left:50%;top:12px;z-index:6;transform:translate(-50%,-6px);padding:8px 14px;border-radius:var(--rp);background:var(--fg);color:var(--paper);
+  box-shadow:var(--sh2);font:500 var(--t-sm)/1.3 var(--f-body);white-space:nowrap;opacity:0;pointer-events:none;transition:opacity .2s,transform .2s}
+.mt-zdica.on{opacity:1;transform:translate(-50%,0)}
+.mt-zdica kbd{font:600 var(--t-xs) var(--f-mono);padding:1px 6px;border-radius:4px;background:var(--paper);color:var(--fg)}
+/* bandeirinhas (cartões das regionais/polos com o fio) e cartões dos municípios: enquanto o mapa se mexe somem e voltam já recalculados
+   (110 ms parado); acima de 1,8x as bandeirinhas saem de cena de vez, porque cada município já mostra o cartão dele */
+.mt-bandeiras,.mt-selos,.mt-nomes2{transition:opacity .15s}
+.mt-nomes2{contain:layout style}
+.mexe .mt-bandeiras,.mexe .mt-selos,.mexe .mt-nomes2,.mexe .mt-regcards button{opacity:0;pointer-events:none}
+.zoom-longe .mt-bandeiras,.zoom-longe .mt-selos,.zoom-longe .mt-regcards button{opacity:0;pointer-events:none}
+@media (prefers-reduced-motion:reduce){.mt-zdica,.mt-nomes2,.mt-selos,.mt-bandeiras{transition:none}}
