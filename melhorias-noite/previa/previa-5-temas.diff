+    al, r = c['alimentador'], c['resumo']
+    se = html.escape(f'{c["se"]} {c["se_nome"]}')
+    ant = f'<span class="eyebrow">{se} · Alimentador {html.escape(al)}</span>\n    <h1>Trechos por ativo</h1>\n'
+    assert h.count(ant) == 1 and h.count('<html lang="pt-BR">') == 1
+    nav = ('<nav class="migalhas" aria-label="Caminho"><a class="lp-voltar-ph" href="../../" title="Voltar a Municípios" aria-label="Voltar a Municípios">←</a>'
+           '<a href="../../">Municípios</a><span class="mig-mun"></span><span class="mig-t" id="mig-trecho"></span></nav>\n    ')
+    h = h.replace(ant, f'{nav}<span class="eyebrow">{se}</span>\n    <h1>{html.escape(al)}</h1>\n    <p class="sub">Trechos por ativo</p>\n')
+    km = f'{r["extensao_m"] / 1000:,.2f}'.replace(',', 'X').replace('.', ',').replace('X', '.')
+    nt = f'{r["trechos"]:,}'.replace(',', '.')
+    nae = c.get('nae') or {}
