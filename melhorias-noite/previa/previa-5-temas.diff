+    if nae.get('meses'):
+        suf = 'vegetação · ' if (c.get('origem') or {}).get('nae_filtro') == 'arvore' else ''
+        sel = (f'<button type="button" class="r-i r-nae" data-ph aria-haspopup="true"><b><span class="r-nr">NAE</span> <span class="r-nn">{len(nae.get("oc", []))}</span></b>'
+               f'<small class="r-np">{suf}todos os meses</small></button>')
+    res = (f'\n  <div class="al-res" role="group" aria-label="Resumo do alimentador"><span class="r-i r-t"><b>{nt}</b><small>{"trecho" if r["trechos"] == 1 else "trechos"}</small></span>'
+           f'<span class="r-i r-k"><b>{km}</b><small>km</small></span>{sel}</div>')
+    h = h.replace('</header>', '</header>' + res, 1)
