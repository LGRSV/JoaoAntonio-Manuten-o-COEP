+}
+
+/* ---------------------------------------------------------------- 2/3 · painel enxuto */
+html.al-painel #det:has(>.resumo-classe){display:none}                    /* a tabela Classe/Trechos/Extensão e o "NAE do alimentador": estão no cabeçalho e na lupa */
+html.al-painel body:not(.tela-cheia) #lista,
+html.al-painel body:not(.tela-cheia) #ord-lista{display:none!important}   /* a lupa já mostra a lista (classes e resultado da busca) */
