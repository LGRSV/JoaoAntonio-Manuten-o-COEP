+/* ============================================================================================
+   Painel do alimentador (tema 4, versão final) — parte CSS
+   Entra por cima de assets/alimentador.css e do CSS que lupa-painel.js injeta. Tudo escopado em html.al-painel (a classe que o
+   gerador já escreve no <html>, para o mapa nascer no tamanho final) e, quando é do layout da página, em body:not(.tela-cheia): a tela cheia (gaveta lateral) segue como está.
+
+     1  uma linha só no alto: ☰ · caminho + código + SE · resumo (trechos, km, NAE) · lupa (olho, campo, Filtros)
+     2  mapa na altura da tela; painel rola por dentro
+     3  resumo único: o que a lupa e o resumo do cabeçalho dizem sai do painel (tabela, NAE, lista de trechos, legenda de cores)
+     4  legenda das classes no mapa (só sem Faixa/Inspeção) + legendas das camadas em linha
+     5  camadas em acordeão
+     6  trecho escolhido: ficha + abas
+     7  celular: gaveta inferior
+   ============================================================================================ */
+
+/* ---------------------------------------------------------------- 1 · uma linha só no alto (a lupa já mora no canto do mapa) */
+html.al-painel body:not(.tela-cheia) .mnu{margin:0}
+/* a barra antiga (extras.js) fica escondida até a lupa a levar para dentro do mapa: sem isso ela ocupa uma célula da grade e empurra o mapa quando sai */
+html.al-painel:not(.p-sem-lupa) body:not(.tela-cheia) .wrap>.barra-busca{display:none}
+html.al-painel body:not(.tela-cheia) header{display:flex;align-items:center;gap:0 var(--s3);min-width:0;max-width:none}
+html.al-painel body:not(.tela-cheia) .migalhas{order:1;flex:none;flex-wrap:nowrap;min-height:0;white-space:nowrap;font-size:var(--t-sm);gap:0 var(--s2)}
+html.al-painel body:not(.tela-cheia) .migalhas .mig-t{display:none}        /* o trecho escolhido já está na ficha do painel (e na gaveta, no celular) */
+html.al-painel body:not(.tela-cheia) h1{order:2;flex:none;font-size:24px;line-height:1.1;margin:0}
+html.al-painel body:not(.tela-cheia) header .eyebrow{order:3;min-width:0;overflow:hidden;text-overflow:ellipsis;font-size:11px;line-height:1.2;white-space:nowrap}
+html.al-painel body:not(.tela-cheia) header .sub{display:none}            /* "Trechos por ativo": o título da aba já diz */
+
+/* resumo: o que era a tabela Classe/Trechos/Extensão (total) e o "NAE - vegetação: N no alimentador" do painel */
+html.al-painel .al-res{display:flex;align-items:center;gap:var(--s4);min-width:0;white-space:nowrap}
+html.al-painel .al-res .r-i{display:grid;gap:3px;justify-items:start;margin:0;padding:0;border:0;background:none;color:var(--fg);font:inherit;text-align:left}
+html.al-painel .al-res b{display:inline-flex;align-items:center;gap:6px;font:700 17px/1 var(--f-mono);font-variant-numeric:tabular-nums;letter-spacing:-.01em}
+html.al-painel .al-res small{font:500 11px/1 var(--f-body);color:var(--muted)}
+html.al-painel .al-res .r-nae{cursor:pointer;border-radius:var(--r2)}
+html.al-painel .al-res .r-nae b{padding:3px 9px 3px 8px;border-radius:var(--rp);background:var(--alerta-fundo);color:#fff;font-size:13px}
+html.al-painel .al-res .r-nae .r-nr{font:600 11px/1 var(--f-body);letter-spacing:.03em;opacity:.9}
+html.al-painel .al-res .r-nae.zero b{background:transparent;color:var(--muted);box-shadow:inset 0 0 0 1px var(--line-forte)}
+html.al-painel .al-res .r-nae:hover small{color:var(--fg)}
+html.al-painel .al-res .r-nae:focus-visible{outline:2px solid var(--accent);outline-offset:4px}
+/* tela cheia: o resumo vai para o alto da gaveta, embaixo da barra */
