+  html.al-painel body:not(.tela-cheia) header{grid-column:2;grid-row:1}
+  html.al-painel body:not(.tela-cheia) .al-res{grid-column:3;grid-row:1;padding-left:var(--s4);border-left:1px solid var(--line);height:40px;align-items:center}
+  html.al-painel body:not(.tela-cheia) .stage{grid-column:1/-1;grid-row:2;height:100%;min-height:0;align-items:stretch;gap:var(--s4);grid-template-columns:minmax(0,1fr) 400px}
+  html.al-painel body:not(.tela-cheia) .mapbox{position:relative;top:auto;height:100%}
+  html.al-painel body:not(.tela-cheia) #map{height:100%;min-height:0}
+  html.al-painel body:not(.tela-cheia) .panel{position:relative;top:auto;height:100%;max-height:none}
+}
+@media (min-width:981px) and (max-width:1280px){                      /* janela estreita: o texto "Municípios" sai (a seta já diz) */
