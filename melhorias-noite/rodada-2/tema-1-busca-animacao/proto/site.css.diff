--- live/site.css	2026-10-15 04:31:21.631859908 +0000
+++ proto/site.css	2026-10-15 05:00:10.096124895 +0000
@@ -516,3 +516,33 @@
 .sug-op .so-mini path{fill:none;stroke:var(--rede);stroke-width:1.2;stroke-linecap:round;stroke-linejoin:round;vector-effect:non-scaling-stroke}
 .sug-op.foco{box-shadow:inset 0 0 0 1px var(--rede)}
 .sug-op.foco .so-x small{color:var(--fg)}
+
+/* ====== Rodada 2 · tema 1 (protótipo) ======
+   1) tela cheia do mapa da página inicial (botão .mt-tc de assets/mapa-extras.js; o #mapa-to ganha .tc-mapa) */
+.mt-tc{position:absolute;top:0;right:0;z-index:6;width:var(--alvo);height:var(--alvo);display:grid;place-items:center;padding:0;border:1px solid var(--line);
+  border-radius:var(--r2);background:var(--paper);color:var(--fg);cursor:pointer;box-shadow:var(--sh1)}
+.mt-tc:hover{background:var(--hover);color:var(--accent)}
+.mt-tc:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+.mt-mapa .mt-tc svg{display:block;width:20px;height:20px;min-height:0;max-height:none;margin:0;pointer-events:none}
+.mt-mapa .mt-tc .sai,.mt-mapa .mt-tc[aria-pressed="true"] .abre{display:none}
+.mt-mapa .mt-tc[aria-pressed="true"] .sai{display:block}
+body.tc-mapa{overflow:hidden}
+#mapa-to.tc-mapa{position:fixed;inset:0;z-index:1000;width:auto;height:auto;margin:0;background:var(--bg);align-items:stretch;
+  padding:max(12px,env(safe-area-inset-top)) max(16px,env(safe-area-inset-right)) max(12px,env(safe-area-inset-bottom)) max(16px,env(safe-area-inset-left));
+  grid-template-rows:auto minmax(0,1fr);gap:var(--s3)}
+#mapa-to.tc-mapa .mt-mapa{height:100%;min-height:0}
+#mapa-to.tc-mapa .mt-mapa>svg{width:100%;height:100%;min-height:0;max-height:none}
+
+/* 2) dados repetidos: seta ← dentro da trilha; cartões dos polos como botões; balão sem o que o mapa já mostra */
+.mt-barra .mt-polos .mt-volta{position:static;margin:0 var(--s1) 0 0;min-height:36px;min-width:36px;padding:0 var(--s2)!important;box-shadow:none;font-size:var(--t-lg)!important}
+.mt-selos .mt-pm{cursor:pointer;font:inherit;color:inherit;text-align:center}
+.mt-selos .mt-pm:hover{border-color:var(--c);background:var(--cartao-2)}
+.mt-selos .mt-pm:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+/* celular: no município aberto a trilha perde o passo "Tocantins" (a seta ← e o Voltar do celular já levam até lá) para não quebrar em duas linhas */
+@media (max-width:480px){
+  .mapa-to:has(.mt-mapa.nivel-mun) .mt-polos .mt-passo[data-ir="estado"],
+  .mapa-to:has(.mt-mapa.nivel-mun) .mt-polos .mt-passo[data-ir="estado"]+.mt-sep{display:none}
+}
+/* na tela cheia o botão fica acima da lista da busca (no celular a lista ocupa a largura toda e cobriria a única saída da tela cheia só por CSS) */
+#mapa-to.tc-mapa .mt-tc{z-index:35}
+@media (max-width:860px){#mapa-to.tc-mapa #ativo-res{right:48px}}   /* a lista deixa livre a coluna do botão (celular: ela ocupa a largura toda e cobriria a badge da 1ª linha) */
