--- a/alimentador/site/site.css
+++ b/alimentador/site/site.css
@@ -596,3 +596,26 @@
   box-shadow:0 0 0 2px var(--cartao),0 1px 4px rgb(0 0 0 / .5);animation:mt-surge .3s ease-out}
 .voando .mt-bandeiras{display:none}
 @media (prefers-reduced-motion:reduce){.mt-fio,.mt-pino{animation:none}}
+/* ====== Rodada 3 · tema 1: sem dado repetido, seta que não some, cartão do polo clicável, balão que não cobre ======
+   1) a seta ← mora na barra, logo antes da trilha (na coluna do mapa a lista dos alimentadores a cobria) */
+#mapa-to .mt-barra .mt-volta{position:static;z-index:auto;flex:none;margin:0;box-shadow:none;align-self:center}
+#mapa-to .mt-barra .mt-volta[hidden]{display:none}
+.mt-barra .mt-polos{flex-wrap:nowrap;align-items:center;gap:var(--s2);max-width:100%;min-width:0}
+.mt-trilha{display:flex;align-items:center;flex:1 1 auto;min-width:0;overflow:hidden;white-space:nowrap}
+.mt-trilha>*{flex:0 1 auto;min-width:0}
+.mt-trilha .mt-passo{overflow:hidden;text-overflow:ellipsis}
+.mt-trilha .mt-sep,.mt-trilha b.mt-atual,.mt-trilha .mt-pchip.mt-atual{flex:none}
+/* celular: o município e o alimentador ficam na mesma linha do olho (a lista dos alimentadores abre embaixo dessa linha e cobriria
+   uma segunda); do polo em diante a trilha começa no que importa (Tocantins e a regional saem: a seta e o Voltar levam até eles) */
+@media (max-width:860px){
+  .mt-barra .mt-polos[data-n="mun"],.mt-barra .mt-polos[data-n="al"]{flex:1 1 0}
+  .mt-polos[data-n="polo"] .mt-trilha>:nth-child(-n+2),.mt-polos[data-n="mun"] .mt-trilha>:nth-child(-n+2),
+  .mt-polos[data-n="al"] .mt-trilha>:nth-child(-n+4){display:none}
+}
+/* 2) o cartão do polo na regional é o botão (a barra não repete mais o nome dos polos) */
+.mt-selos button.mt-mn.mt-pm{font:inherit;color:var(--cartao-fg);text-align:center;cursor:pointer;pointer-events:auto;-webkit-tap-highlight-color:transparent;transition:border-color .15s,background-color .15s}
+.mt-selos button.mt-mn.mt-pm:hover{border-color:var(--c);background:var(--cartao-2)}
+.mt-selos button.mt-mn.mt-pm:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
+/* 3) balão do município: sem o cabeçalho quando o cartão já diz nome e NAE; vai para baixo do mouse se cobrir o cartão do próprio município */
+.mt-dica small.sem-h{margin-top:0}
+.mt-dica.abaixo{transform:translate(-50%,0)}
