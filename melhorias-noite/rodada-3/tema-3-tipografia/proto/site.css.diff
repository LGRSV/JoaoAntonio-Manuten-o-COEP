+  padding:var(--s3) var(--s3) var(--s2);background:var(--cartao);border:0;border-bottom:1px solid var(--cartao-borda);text-transform:none;letter-spacing:0;color:var(--cartao-fg)}
+#ativo-res.lista-mun .sug-t b{font:700 var(--t-xl)/1.1 var(--f-display);letter-spacing:.01em}
+#ativo-res.lista-mun .sug-t small{grid-column:1/-1;font:600 var(--t-xs)/1.2 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--cartao-mute)}
+#ativo-res.lista-mun .sug-op:hover,#ativo-res.lista-mun .sug-op.marcado{background:var(--cartao-2)}
+#ativo-res.lista-mun .sug-op .so-x{color:var(--cartao-fg)}
+#ativo-res.lista-mun .so-x b{font:600 var(--t-md)/1.2 var(--f-mono);letter-spacing:.01em}
+#ativo-res.lista-mun .so-x small{color:var(--cartao-mute);font-variant-numeric:tabular-nums}
+#ativo-res.lista-mun .so-mini{background:#000;box-shadow:inset 0 0 0 1px var(--cartao-borda)}
+#ativo-res.lista-mun .sug-op.foco{box-shadow:inset 0 0 0 1px var(--rede);background:var(--cartao-2)}
+#ativo-res.lista-mun .sug-op.foco .so-x small{color:var(--cartao-fg)}
+#ativo-res.lista-mun .sug-op:hover .so-x b,#ativo-res.lista-mun .sug-op.marcado .so-x b{color:#f08a5d}
+#ativo-res.lista-mun .so-n{background:var(--selo)}
+#ativo-res.lista-mun .sug-t .so-n{font-size:var(--t-sm)}
+#ativo-res.lista-mun .sug-t .so-n{display:inline-block;margin:0;padding:2px 7px;border-radius:5px;background:var(--selo);color:#fff;font:700 var(--t-xs)/1.2 var(--f-mono);font-style:normal;font-variant-numeric:tabular-nums}
+#ativo-res.lista-mun .sug-t .so-n .vh{position:static;width:auto;height:auto;overflow:visible;clip:auto;margin-left:3px;font-weight:700}
+#ativo-res.lista-mun .so-mini path{stroke:#5aa6ec}
+#ativo-res.lista-mun .sug-op.foco{box-shadow:inset 0 0 0 1px #5aa6ec}
