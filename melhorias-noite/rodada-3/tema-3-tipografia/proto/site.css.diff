+/* ====== tema 3 (tipografia) ====== */
+/* cartão do alimentador em foco (mapa-municipios.js: .mt-ac): o mesmo cartão preto dos municípios; abre a página do alimentador */
+.mt-ac{display:grid;gap:5px;width:max-content;max-width:min(300px,100%);padding:10px 12px 11px;border:1px solid var(--cartao-borda);border-radius:var(--r2);
+  background:var(--cartao);color:var(--cartao-fg);text-decoration:none;box-shadow:0 10px 24px -8px rgb(0 0 0 / .6);animation:mt-surge .3s ease-out}
+.mt-ac[hidden]{display:none}
+.mt-ac:hover{background:var(--cartao-2);border-color:var(--selo)}
+.mt-ac:focus-visible{outline:2px solid var(--foco-mapa);outline-offset:2px}
+.mt-ac-h{display:flex;align-items:center;gap:12px}
+.mt-ac b{font:600 var(--t-md)/1.2 var(--f-mono);letter-spacing:.01em}
+.mt-ac i{margin-left:auto;padding:2px 6px;border-radius:5px;background:var(--selo);color:#fff;font:700 var(--t-xs)/1.2 var(--f-mono);font-style:normal;font-variant-numeric:tabular-nums}
+.mt-ac small{font:400 var(--t-xs)/1.35 var(--f-body);color:var(--cartao-mute);font-variant-numeric:tabular-nums}
+.mt-ac-ir{margin-top:2px;padding-top:7px;border-top:1px solid var(--cartao-borda);font:600 var(--t-xs)/1 var(--f-mono);letter-spacing:.08em;text-transform:uppercase;color:var(--cartao-fg)}
+.mt-ac-ir span{color:#f08a5d}
+@media (max-width:860px){
+  .mt-lado .mt-ac{position:absolute;left:50%;bottom:6px;z-index:5;transform:translateX(-50%);width:calc(100% - 16px);max-width:340px}
+}
+/* lista dos alimentadores do município, embaixo da busca (busca-ativo.js, #ativo-res.lista-mun): também é um cartão preto nos dois temas.
+   Cabeçalho: município em Plex Sans Condensed 700 + selo da NAE do município + "N alimentadores" em mono; linhas: código em mono,
+   km e subestação em cinza, selo da NAE à direita (o mesmo selo dos cartões do mapa). */
+#ativo-res.lista-mun{background:var(--cartao);color:var(--cartao-fg);border:1px solid var(--cartao-borda);box-shadow:0 14px 30px -10px rgb(0 0 0 / .65);padding:0 var(--s1) var(--s1)}
