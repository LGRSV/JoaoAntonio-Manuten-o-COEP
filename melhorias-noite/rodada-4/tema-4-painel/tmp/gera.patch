+def cabecalho_painel(h, c):
+    """Cabeçalho do painel já no HTML (tema 4): classe no <html>, caminho com a seta ←, SE, código, resumo (trechos, km e o selo da NAE) e o
+    marcador 'pronto'. Antes disso o 1º script do cabeçalho trocava o texto do h1/eyebrow e o extras.js montava o resumo depois dos dados, e o
+    mapa pulava. O painel.js só completa (NAE por mês, município no caminho)."""
+    al, r = c['alimentador'], c['resumo']
+    se = html.escape(f'{c["se"]} {c["se_nome"]}')
+    ant = f'<span class="eyebrow">{se} · Alimentador {html.escape(al)}</span>\n    <h1>Trechos por ativo</h1>\n'
+    assert h.count(ant) == 1 and h.count('<html lang="pt-BR">') == 1
+    nav = ('<nav class="migalhas" aria-label="Caminho"><a class="lp-voltar-ph" href="../../" title="Voltar a Municípios" aria-label="Voltar a Municípios">←</a>'
+           '<a href="../../">Municípios</a><span class="mig-mun"></span><span class="mig-t" id="mig-trecho"></span></nav>\n    ')
+    h = h.replace(ant, f'{nav}<span class="eyebrow">{se}</span>\n    <h1>{html.escape(al)}</h1>\n    <p class="sub">Trechos por ativo</p>\n')
+    km = f'{r["extensao_m"] / 1000:,.2f}'.replace(',', 'X').replace('.', ',').replace('X', '.')
+    nt = f'{r["trechos"]:,}'.replace(',', '.')
+    nae = c.get('nae') or {}
+    sel = ''
+    if nae.get('meses'):
+        suf = 'vegetação · ' if (c.get('origem') or {}).get('nae_filtro') == 'arvore' else ''
+        sel = (f'<button type="button" class="r-i r-nae" data-ph aria-haspopup="true"><b><span class="r-nr">NAE</span> <span class="r-nn">{len(nae.get("oc", []))}</span></b>'
+               f'<small class="r-np">{suf}todos os meses</small></button>')
+    res = (f'\n  <div class="al-res" role="group" aria-label="Resumo do alimentador"><span class="r-i r-t"><b>{nt}</b><small>{"trecho" if r["trechos"] == 1 else "trechos"}</small></span>'
+           f'<span class="r-i r-k"><b>{km}</b><small>km</small></span>{sel}</div>')
+    h = h.replace('</header>', '</header>' + res, 1)
+    h = h.replace('<html lang="pt-BR">', '<html lang="pt-BR" class="al-site al-painel">', 1)      # a classe no HTML: o mapa já nasce no tamanho final
+    h, n = re.subn(r'  <script>\n  // Página do site \(CSS em assets/\).*?</script>',
+                   "  <script>document.addEventListener('DOMContentLoaded', function () { document.documentElement.classList.add('al-pronto'); });</script>", h, count=1, flags=re.S)
+    assert n == 1
+    return h
+
